<!-- SEO Meta Tags -->
<meta name="description"
    content="Learn about UniPick's mission to connect students with the best-fit universities. Meet our lead consultant and understand how we help shape your academic future.">
<meta name="keywords"
    content="about our university admissions consultant, UniPick's mission, meet our education consultant, university counseling expert, Ravi Vajendla CA consultant">
<meta property="og:title" content="About UniPick - Meet Our University Admissions Consultant">
<meta property="og:description"
    content="Learn about UniPick's mission to connect students with the best-fit universities. Meet our lead consultant and understand how we help shape your academic future.">
<meta property="og:type" content="website">
<meta property="og:image" content="https://unipick.org/about-image.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="About UniPick - Meet Our University Admissions Consultant">
<meta name="twitter:description"
    content="Learn about UniPick's mission to connect students with the best-fit universities. Meet our lead consultant and understand how we help shape your academic future.">

<style>
    /* ========================================
       ABOUT PAGE - INSTITUTIONAL TWO-COLUMN LAYOUT
    ========================================= */

    :root {
        --primary-blue: #007BFF;
        --academic-dark: #002b5e;
        --text-dark: #1B1F24;
        --text-gray: #4B5563;
        --border-color: #e5e7eb;
        --bg-light: #F7FAFC;
    }

    html, body {
        scroll-behavior: smooth;
    }

    /* Container & Layout */
    .about-container {
        max-width: 1440px;
        margin: 0 auto;
        padding: 40px 5%;
    }

    .about-layout {
        display: flex;
        gap: 60px;
        align-items: flex-start;
    }

    /* Left Sidebar */
    .about-sidebar {
        width: 25%;
        flex-shrink: 0;
        position: sticky;
        top: 100px; /* Below sticky header */
        background: #FFFFFF;
        padding-right: 20px;
    }

    .sidebar-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 2rem;
        font-weight: 300;
        color: var(--academic-dark);
        margin-bottom: 24px;
        letter-spacing: -0.02em;
        text-decoration: none;
        border: none;
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
    }

    .sidebar-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        min-height: 56px;
        color: var(--academic-dark);
        text-decoration: none;
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        border-bottom: 1px solid var(--border-color);
        transition: all 0.2s ease;
    }

    .sidebar-link i {
        font-size: 0.8rem;
        color: var(--academic-dark);
        transition: all 0.2s ease;
        opacity: 0.5;
    }

    .sidebar-link:hover {
        background: var(--bg-light);
        color: var(--primary-blue);
    }

    .sidebar-link:hover i {
        color: var(--primary-blue);
        opacity: 1;
        transform: translateX(4px);
    }

    .sidebar-link.active {
        background: var(--primary-blue);
        color: #FFFFFF;
        border-bottom-color: var(--primary-blue);
        font-weight: 600;
    }

    .sidebar-link.active i {
        color: #FFFFFF;
        opacity: 1;
    }

    /* Right Main Content */
    .about-content {
        flex: 1;
        max-width: 850px;
    }

    /* Breadcrumbs override for light background */
    .about-container > .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 30px;
        box-shadow: none;
        border: none;
        font-size: 0.9rem;
    }

    .about-container > .breadcrumb a {
        color: var(--academic-dark);
    }
    
    .about-container > .breadcrumb span {
        color: var(--text-gray);
        font-weight: 500;
    }
    
    .about-container > .breadcrumb a:hover {
        color: var(--primary-blue);
    }

    .about-container > .breadcrumb a::after,
    .about-container > .breadcrumb span::after {
        background: rgba(0, 0, 0, 0.2);
    }


    /* Main Page Header */
    .main-page-header {
        margin-bottom: 60px;
    }

    .main-page-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 3.5rem;
        font-weight: 300;
        color: var(--academic-dark);
        letter-spacing: -0.02em;
        margin-bottom: 24px;
        line-height: 1.1;
    }

    .main-page-lead {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.4rem;
        font-style: italic;
        color: var(--academic-dark);
        line-height: 1.6;
        font-weight: 400;
    }

    /* Content Blocks (Sections) */
    .content-block {
        margin-bottom: 40px;
        padding-top: 20px; /* For scrollspy offset */
        animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .section-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 3.5rem;
        font-weight: 300;
        color: var(--academic-dark);
        letter-spacing: -0.02em;
        margin-bottom: 24px;
        line-height: 1.1;
        text-decoration: none;
        border: none;
        padding-bottom: 0;
    }

    .section-title::after,
    .section-title::before {
        display: none !important;
        content: none !important;
    }

    .section-subtitle {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.4rem;
        font-style: italic;
        color: var(--academic-dark);
        line-height: 1.6;
        font-weight: 400;
        margin: 0 0 30px 0 !important;
        text-align: left !important;
        max-width: 100% !important;
    }

    .body-text {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 1.1rem;
        line-height: 1.8;
        color: var(--text-dark);
        margin-bottom: 24px;
        font-weight: 400;
    }

    /* Mission Highlights */
    .platform-highlights {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        margin-top: 40px;
        border-top: 1px solid var(--border-color);
        padding-top: 40px;
    }

    .platform-highlight {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .highlight-icon {
        font-size: 1.8rem;
        color: var(--primary-blue);
        margin-top: 4px;
    }

    .highlight-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 8px;
    }

    .highlight-text {
        font-family: var(--font-body), 'Inter', sans-serif;
        color: var(--text-gray);
        font-size: 1rem;
        line-height: 1.6;
    }

    /* Consultant Profile */
    .consultant-layout {
        display: flex;
        gap: 40px;
        align-items: flex-start;
        margin-top: 30px;
    }

    .consultant-image {
        width: 250px;
        flex-shrink: 0;
    }

    .consultant-image img {
        width: 100%;
        height: auto;
        display: block;
        border: 1px solid var(--border-color);
    }

    .consultant-info h3 {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 8px;
    }

    .consultant-job-title {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-blue);
        margin-bottom: 24px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .expertise-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
    }

    .expertise-tag {
        background: var(--bg-light);
        color: var(--academic-dark);
        padding: 8px 16px;
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid var(--border-color);
    }

    /* Metrics */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        margin-top: 30px;
    }

    .metric-box {
        padding: 30px;
        background: var(--bg-light);
        border: 1px solid var(--border-color);
    }

    .metric-number {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 3.5rem;
        font-weight: 300;
        color: var(--primary-blue);
        line-height: 1;
        margin-bottom: 12px;
    }

    .metric-label {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-dark);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Values Grid */
    .values-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        margin-top: 40px;
    }

    .value-item {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .value-icon {
        font-size: 1.5rem;
        color: var(--primary-blue);
        margin-top: 4px;
    }

    .value-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 8px;
    }

    .value-description {
        font-family: var(--font-body), 'Inter', sans-serif;
        color: var(--text-gray);
        font-size: 1rem;
        line-height: 1.6;
    }

    /* Timeline */
    .timeline-container {
        border-left: 2px solid var(--border-color);
        padding-left: 30px;
        margin-top: 40px;
        margin-left: 10px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 40px;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -37px;
        top: 6px;
        width: 12px;
        height: 12px;
        background: #FFFFFF;
        border: 2px solid var(--primary-blue);
        border-radius: 50%;
    }

    .timeline-date {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary-blue);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
    }

    .timeline-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 12px;
    }

    /* Quote / Highlight Block */
    .editorial-quote {
        border-left: 6px solid var(--primary-blue);
        padding: 20px 0 20px 40px;
        margin: 60px 0;
        background: transparent;
    }

    .quote-text {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.6rem;
        line-height: 1.6;
        color: var(--academic-dark);
        font-style: italic;
        margin-bottom: 24px;
    }

    .quote-author {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Partners */
    .partner-logos {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 30px;
    }

    .partner-logo {
        padding: 12px 24px;
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--academic-dark);
    }

    /* CTA Section */
    .cta-buttons {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .cta-btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 14px 28px;
        background: var(--primary-blue);
        color: #FFFFFF;
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        border-radius: 4px; /* Rectangular corners */
    }

    .cta-btn-primary i {
        margin-right: 10px;
    }

    .cta-btn-primary:hover {
        background: var(--academic-dark);
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .about-layout {
            flex-direction: column;
        }

        .about-sidebar {
            width: 100%;
            position: static;
            padding-right: 0;
            margin-bottom: 40px;
        }

        .about-content {
            max-width: 100%;
        }

        .main-page-title {
            font-size: 2.8rem;
        }

        .platform-highlights, .values-grid, .metrics-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .consultant-layout {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .main-page-title {
            font-size: 2.2rem;
        }

        .main-page-lead {
            font-size: 1.2rem;
        }
        
        .section-title {
            font-size: 2.2rem;
        }

        .editorial-quote {
            padding-left: 20px;
        }

        .quote-text {
            font-size: 1.3rem;
        }
        
        .cta-buttons {
            flex-direction: column;
        }
    }
</style>

<div class="about-container">
    <!-- Breadcrumbs -->
    <% const breadcrumbs=[ { name: 'Home' , url: '/' }, { name: 'About Us' , url: '' } ]; %>
    <%- include('partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>
    <div style="margin-bottom: 30px;"></div>

    <div class="about-layout">
        <!-- Sidebar Navigation -->
        <aside class="about-sidebar">
            <h2 class="sidebar-title">About Us</h2>
            <nav class="sidebar-nav" id="about-nav">
                <a href="#mission" class="sidebar-link active">UniPick's Mission <i class="fas fa-chevron-right"></i></a>
                <a href="#consultant" class="sidebar-link">Education Consultant <i class="fas fa-chevron-right"></i></a>
                <a href="#impact" class="sidebar-link">Impact in Numbers <i class="fas fa-chevron-right"></i></a>
                <a href="#values" class="sidebar-link">Our Core Values <i class="fas fa-chevron-right"></i></a>
                <a href="#journey" class="sidebar-link">Professional Journey <i class="fas fa-chevron-right"></i></a>
                <a href="#network" class="sidebar-link">University Network <i class="fas fa-chevron-right"></i></a>
                <a href="#cta" class="sidebar-link">Begin Your Journey <i class="fas fa-chevron-right"></i></a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="about-content">
            <!-- Mission Section -->
            <section id="mission" class="content-block" itemscope itemtype="http://schema.org/AboutPage">
                <h2 class="section-title" itemprop="name">UniPick's Mission - Connecting Students with Best-Fit Universities</h2>
                <p class="section-subtitle" itemprop="description">Transforming how students discover and choose their ideal universities through expert university admissions guidance</p>

                <p class="body-text" itemprop="about">
                    UniPick is India's most comprehensive and transparent university selection platform, designed to empower students and parents with the information and guidance needed to make confident higher education decisions. We bridge the gap between aspirations and opportunities through verified data, expert insights, and personalized university admissions help.
                </p>
                <p class="body-text">
                    Unlike traditional admission consultancies, we prioritize long-term student success over commissions, providing unbiased recommendations based on academic fit, career prospects, and individual goals with our expert education consultant team.
                </p>

                <div class="platform-highlights">
                    <div class="platform-highlight">
                        <i class="fas fa-database highlight-icon"></i>
                        <div>
                            <h4 class="highlight-title">Data-Driven Decisions</h4>
                            <p class="highlight-text">Compare universities using verified placement records, ROI analysis, and real student outcomes.</p>
                        </div>
                    </div>
                    <div class="platform-highlight">
                        <i class="fas fa-user-check highlight-icon"></i>
                        <div>
                            <h4 class="highlight-title">Expert Verification</h4>
                            <p class="highlight-text">Every university listing verified by experienced education consultants and industry professionals.</p>
                        </div>
                    </div>
                    <div class="platform-highlight">
                        <i class="fas fa-chart-line highlight-icon"></i>
                        <div>
                            <h4 class="highlight-title">Career-Focused Approach</h4>
                            <p class="highlight-text">We evaluate programs based on future employability and industry alignment, not just rankings.</p>
                        </div>
                    </div>
                    <div class="platform-highlight">
                        <i class="fas fa-handshake highlight-icon"></i>
                        <div>
                            <h4 class="highlight-title">Direct University Access</h4>
                            <p class="highlight-text">Connect directly with verified university representatives through our trusted network.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Education Consultant Section -->
            <section id="consultant" class="content-block" itemscope itemtype="http://schema.org/Person">
                <h2 class="section-title">Meet Our Education Consultant - Your Expert Guide</h2>
                
                <div class="consultant-layout">
                    <div class="consultant-image">
                        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=600&h=600&fit=crop"
                            alt="Ravi Vajendla, UniPick Founder and Lead University Admissions Consultant" itemprop="image"
                            loading="lazy">
                    </div>
                    <div class="consultant-info">
                        <h3 itemprop="name">Ravi Vajendla</h3>
                        <p class="consultant-job-title" itemprop="jobTitle">Chartered Accountant & Senior University Admissions Consultant</p>
                        
                        <meta itemprop="worksFor" content="UniPick Education Consultancy">
                        <meta itemprop="alumniOf" content="Institute of Chartered Accountants of India">

                        <p class="body-text" itemprop="description">
                            With over 15 years of experience spanning finance and education consulting, Ravi brings a unique analytical lens to university admissions. As a qualified Chartered Accountant, he understands the financial implications and return on investment of education decisions—ensuring families make choices that are both academically sound and financially sustainable through expert university admissions help.
                        </p>
                        <p class="body-text">
                            His transition from corporate finance to education consulting was driven by witnessing the impact of ill-informed admission decisions on students' careers. Having personally guided over 800 students with a 97% success rate, Ravi specializes in matching student profiles with institutions where they can genuinely thrive—considering academic excellence, cultural fit, and long-term career trajectories.
                        </p>

                        <div class="expertise-tags">
                            <span class="expertise-tag" itemprop="knowsAbout">University Selection Strategy</span>
                            <span class="expertise-tag" itemprop="knowsAbout">ROI & Financial Analysis</span>
                            <span class="expertise-tag" itemprop="knowsAbout">Career Path Planning</span>
                            <span class="expertise-tag" itemprop="knowsAbout">Education Financing</span>
                            <span class="expertise-tag" itemprop="knowsAbout">Admission Process Management</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Metrics Section -->
            <section id="impact" class="content-block">
                <h2 class="section-title">Our Impact in Numbers</h2>
                <p class="section-subtitle">Measurable success built on trust and expert university admissions guidance</p>

                <div class="metrics-grid">
                    <div class="metric-box">
                        <div class="metric-number">800+</div>
                        <div class="metric-label">Students Guided</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-number">97%</div>
                        <div class="metric-label">Success Rate</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-number">15+</div>
                        <div class="metric-label">Years Experience</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-number">50+</div>
                        <div class="metric-label">Partner Universities</div>
                    </div>
                </div>
            </section>

            <!-- Core Values -->
            <section id="values" class="content-block">
                <h2 class="section-title">Our Core Values</h2>
                <p class="section-subtitle">The principles that guide every student interaction at our university admissions consultant practice</p>

                <div class="values-grid">
                    <div class="value-item">
                        <i class="fas fa-balance-scale value-icon"></i>
                        <div>
                            <h4 class="value-title">Transparency First</h4>
                            <p class="value-description">Complete disclosure of all university metrics and performance data</p>
                        </div>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-graduation-cap value-icon"></i>
                        <div>
                            <h4 class="value-title">Student-Centric</h4>
                            <p class="value-description">Recommendations tailored to individual goals and circumstances</p>
                        </div>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-chart-pie value-icon"></i>
                        <div>
                            <h4 class="value-title">Data-Driven Insights</h4>
                            <p class="value-description">Decisions based on verified statistics and ROI analysis</p>
                        </div>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-shield-alt value-icon"></i>
                        <div>
                            <h4 class="value-title">Ethical Practice</h4>
                            <p class="value-description">Zero commission-based recommendations, only merit-based guidance</p>
                        </div>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-award value-icon"></i>
                        <div>
                            <h4 class="value-title">Quality Excellence</h4>
                            <p class="value-description">Partnerships only with verified, high-performing institutions</p>
                        </div>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-lightbulb value-icon"></i>
                        <div>
                            <h4 class="value-title">Innovation Focus</h4>
                            <p class="value-description">Technology-enabled matching and personalized counseling</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Professional Journey -->
            <section id="journey" class="content-block">
                <h2 class="section-title">Professional Journey</h2>
                <p class="section-subtitle">From Chartered Accountant to Education Innovation Leader</p>

                <div class="timeline-container">
                    <div class="timeline-item">
                        <div class="timeline-date">2005-2009</div>
                        <h3 class="timeline-title">CA Qualification & Early Career</h3>
                        <p class="body-text">
                            Qualified as Chartered Accountant from ICAI with distinction, developing strong analytical foundations and financial assessment expertise through rigorous training.
                        </p>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2010-2015</div>
                        <h3 class="timeline-title">Corporate Finance & Audit</h3>
                        <p class="body-text">
                            5+ years in corporate finance and institutional audit for leading educational organizations, gaining deep insights into university operations, financial sustainability, and quality metrics.
                        </p>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2016-2017</div>
                        <h3 class="timeline-title">Transition to Education Consulting</h3>
                        <p class="body-text">
                            Recognized critical gaps in transparent admission guidance. Began consulting part-time while maintaining CA practice, helping students make data-informed university choices.
                        </p>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-date">2018-Present</div>
                        <h3 class="timeline-title">UniPick Platform Launch</h3>
                        <p class="body-text">
                            Founded UniPick to democratize access to quality admission guidance at scale. Platform now serves hundreds of students annually with technology-enabled personalized counseling and verified university data.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Partner Universities -->
            <section id="network" class="content-block">

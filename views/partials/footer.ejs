<!-- partials/footer.ejs -->
<style>
    /* ========================================
       FOOTER - INSTITUTIONAL REDESIGN
    ========================================= */
    :root {
        --footer-deep-navy: #063B82;
        --footer-darker-navy: #032E68;
        --footer-bright-blue: #0099D8;
        --footer-text: #FFFFFF;
        --footer-text-secondary: rgba(255, 255, 255, 0.85);
        --footer-border: rgba(255, 255, 255, 0.15);
    }

    .inst-footer {
        font-family: var(--font-body), sans-serif;
        color: var(--footer-text);
        background-color: var(--footer-deep-navy);
        display: flex;
        flex-direction: column;
    }

    .inst-footer-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 40px;
        width: 100%;
    }

    /* Top Utility Bar */
    .inst-footer-top {
        background-color: var(--footer-darker-navy);
        padding: 15px 0;
    }

    .inst-footer-top .inst-footer-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .inst-footer-utils {
        color: var(--footer-text);
        font-size: 1.4rem;
        font-weight: 500;
        margin: 0;
        font-family: var(--font-heading), serif;
    }

    .inst-footer-btn {
        background-color: var(--footer-bright-blue);
        color: #FFFFFF;
        text-decoration: none;
        padding: 12px 28px;
        font-size: 1.05rem;
        font-weight: 600;
        border-radius: 4px;
        transition: background-color 0.2s, transform 0.2s;
        display: inline-block;
        border: none;
    }

    .inst-footer-btn:hover {
        background-color: #007bb0;
        color: #FFFFFF;
        transform: translateY(-2px);
        text-decoration: none;
    }

    /* Main Footer Body */
    .inst-footer-main {
        padding: 40px 0;
    }

    .inst-footer-grid {
        display: grid;
        grid-template-columns: 2fr 1.5fr 1.5fr;
        gap: 60px;
    }

    .inst-footer-col h3 {
        color: #FFFFFF;
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 25px;
        font-family: var(--font-heading), serif;
    }

    /* Column 1: Brand */
    .inst-footer-brand-desc {
        color: var(--footer-text-secondary);
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 25px;
        max-width: 90%;
    }

    .inst-footer-address {
        font-style: normal;
        color: var(--footer-text-secondary);
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .inst-footer-map-btn {
        display: inline-block;
        color: var(--footer-text);
        text-decoration: none;
        border: 1px solid var(--footer-text);
        padding: 8px 20px;
        border-radius: 4px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s ease;
        margin-bottom: 30px;
    }

    .inst-footer-map-btn:hover {
        background-color: var(--footer-text);
        color: var(--footer-deep-navy);
        text-decoration: none;
    }

    /* Column 2 & 3: Lists */
    .inst-footer-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--footer-border);
    }

    .inst-footer-list li {
        border-bottom: 1px solid var(--footer-border);
    }

    .inst-footer-list a {
        display: flex;
        align-items: center;
        padding: 10px 0;
        color: var(--footer-bright-blue);
        text-decoration: none;
        font-size: 1.05rem;
        font-weight: 500;
        transition: padding-left 0.2s ease, color 0.2s ease;
    }

    .inst-footer-list a i {
        margin-right: 12px;
        width: 20px;
        text-align: center;
        color: var(--footer-text-secondary);
        transition: color 0.2s ease;
    }

    .inst-footer-list a:hover {
        padding-left: 8px;
        color: #FFFFFF;
        text-decoration: none;
    }

    .inst-footer-list a:hover i {
        color: #FFFFFF;
    }

    /* Bottom Legal Bar */
    .inst-footer-bottom {
        background-color: var(--footer-darker-navy);
        border-top: 1px solid var(--footer-border);
        padding: 20px 0;
    }

    .inst-footer-bottom .inst-footer-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .inst-footer-legal {
        display: flex;
        gap: 25px;
    }

    .inst-footer-legal a {
        color: var(--footer-text-secondary);
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }

    .inst-footer-legal a:hover {
        color: #FFFFFF;
        text-decoration: none;
    }

    .inst-footer-copyright {
        color: var(--footer-text-secondary);
        font-size: 0.95rem;
        margin: 0;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .inst-footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }
        .inst-footer-col:first-child {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        .inst-footer-top .inst-footer-container {
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
        }
        .inst-footer-utils {
            flex-wrap: wrap;
            gap: 15px 25px;
        }
        .inst-footer-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .inst-footer-bottom .inst-footer-container {
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
        }
        .inst-footer-legal {
            flex-wrap: wrap;
            gap: 15px;
        }
        .inst-footer-container {
            padding: 0 25px;
        }
        .inst-footer-main {
            padding: 30px 0;
        }
    }
</style>


<%- include('partials/header') %>

<style>
    /* ========================================
       QUIZ PAGE - INSTITUTIONAL 3-COLUMN LAYOUT
    ======================================== */

    :root {
        --primary-blue: #007BFF;
        --academic-dark: #002b5e;
        --text-dark: #1B1F24;
        --text-gray: #4B5563;
        --border-color: #e5e7eb;
        --bg-light: #F7FAFC;
    }

    html, body {
        overflow-x: hidden;
        scroll-behavior: smooth;
        background-color: #ffffff;
    }

    /* Breadcrumbs override for light background */
    .institutional-container > .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 30px;
        box-shadow: none;
        border: none;
        font-size: 0.9rem;
    }

    .institutional-container > .breadcrumb a {
        color: var(--academic-dark);
    }
    
    .institutional-container > .breadcrumb span {
        color: var(--text-gray);
        font-weight: 500;
    }
    
    .institutional-container > .breadcrumb a:hover {
        color: var(--primary-blue);
    }

    .institutional-container > .breadcrumb a::after,
    .institutional-container > .breadcrumb span::after {
        background: rgba(0, 0, 0, 0.2);
    }

    /* Container & Layout */
    .institutional-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 40px 3% 80px;
    }

    .institutional-layout {
        display: grid;
        grid-template-columns: 250px 1fr;
        gap: 40px;
        align-items: flex-start;
        border-top: 1px solid var(--border-color);
        padding-top: 40px;
    }

    /* Common Navigation Styles */
    .nav-heading {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid var(--academic-dark);
        padding-bottom: 12px;
    }

    /* Column 1: Quiz Navigation */
    .col-quiz-nav {
        border-right: 1px solid var(--border-color);
        padding-right: 20px;
        min-height: 60vh;
        position: sticky;
        top: 100px;
    }

    .quiz-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .quiz-nav-list li {
        padding: 14px 15px;
        color: var(--text-gray);
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        border-left: 3px solid transparent;
        margin-bottom: 5px;
        transition: all 0.2s ease;
        background: transparent;
    }

    .quiz-nav-list li.active {
        color: var(--primary-blue);
        font-weight: 700;
        border-left: 3px solid var(--primary-blue);
        background: rgba(0, 123, 255, 0.05);
    }

    .quiz-nav-list li.completed {
        color: #10B981; /* Green for completed */
        border-left-color: #10B981;
    }

    /* Column 3: Main Content */
    .col-quiz-content {
        padding-left: 10px;
        max-width: 900px;
    }

    /* Quiz Steps Logic */
    .quiz-step {
        display: none;
        animation: fadeIn 0.4s ease;
    }

    .quiz-step.active {
        display: block;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Quiz Header */
    .quiz-header {
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .quiz-header h2 {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 2.2rem;
        font-weight: 300;
        color: var(--academic-dark);
        margin-bottom: 10px;
        letter-spacing: -0.01em;
    }

    .quiz-header p {
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 1.1rem;
        font-style: italic;
        color: var(--text-gray);
        line-height: 1.6;
    }

    /* Stream Options */
    .stream-options-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .stream-option-card {
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        padding: 20px 25px;
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .stream-option-card:hover {
        border-color: var(--primary-blue);
        background: rgba(0, 123, 255, 0.02);
    }

    .stream-option-card.selected {
        background: var(--primary-blue);
        border-color: var(--primary-blue);
    }

    .stream-option-card i {
        font-size: 1.8rem;
        color: var(--primary-blue);
        margin-right: 20px;
        width: 40px;
        text-align: center;
        transition: color 0.2s ease;
    }

    .stream-option-card.selected i {
        color: #FFFFFF;
    }

    .stream-text-content {
        flex: 1;
    }

    .stream-option-title {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 4px;
        transition: color 0.2s ease;
    }

    .stream-option-card.selected .stream-option-title {
        color: #FFFFFF;
    }

    .stream-option-subtitle {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.9rem;
        color: var(--text-gray);
        font-weight: 400;
        transition: color 0.2s ease;
    }

    .stream-option-card.selected .stream-option-subtitle {
        color: rgba(255, 255, 255, 0.85);
    }

    /* Question Interface */
    .question-container {
        margin-bottom: 30px;
    }

    .question-card {
        background: #FFFFFF;
    }

    .question-number {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--primary-blue);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 15px;
    }

    .question-text {
        font-family: var(--font-heading), 'Inter', sans-serif;
        font-size: 1.8rem;
        font-weight: 400;
        color: var(--academic-dark);
        margin-bottom: 35px;
        line-height: 1.4;
    }

    .answer-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .question-option {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .question-option:hover {
        border-color: var(--primary-blue);
        background: rgba(0, 123, 255, 0.02);
    }

    .question-option.selected {
        background: var(--primary-blue);
        border-color: var(--primary-blue);
    }

    .option-number {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-gray);
        width: 30px;
        margin-right: 15px;
        transition: color 0.2s ease;
    }

    .question-option:hover .option-number {
        color: var(--primary-blue);
    }

    .question-option.selected .option-number {
        color: rgba(255, 255, 255, 0.7);
    }

    .option-text {
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-dark);
        flex: 1;
        transition: color 0.2s ease;
    }

    .question-option.selected .option-text {
        color: #FFFFFF;
        font-weight: 600;
    }

    /* Navigation Buttons */
    .quiz-navigation {
        margin-top: 40px;
        display: flex;
        justify-content: flex-start;
    }

    .quiz-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 28px;
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        border: 1px solid var(--border-color);
        background: #FFFFFF;
        color: var(--academic-dark);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .quiz-btn:hover:not(:disabled) {
        background: var(--bg-light);
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

    .quiz-btn.accent {
        background: var(--primary-blue);
        color: #FFFFFF;
        border-color: var(--primary-blue);
    }

    .quiz-btn.accent:hover {
        background: var(--academic-dark);
        border-color: var(--academic-dark);
        color: #FFFFFF;
    }

    .quiz-btn i {
        margin-right: 8px;
    }

    /* Student Info Form */
    .student-info-form {
        max-width: 100%;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 24px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group label {
        display: block;
        font-family: var(--font-body), 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--academic-dark);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .form-group label .required {
        color: #DC2626;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        font-size: 1rem;
        font-family: var(--font-body), 'Inter', sans-serif;
        border: 1px solid var(--border-color);
        background: #FFFFFF;
        color: var(--text-dark);
        transition: all 0.2s ease;
        border-radius: 0;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary-blue);
        box-shadow: 0 0 0 1px var(--primary-blue);
    }

    /* Loader */
    .loading-container {
        padding: 60px 0;
    }

    .loader {
        border: 4px solid var(--bg-light);
        border-top: 4px solid var(--primary-blue);
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin-bottom: 24px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .institutional-layout {
            grid-template-columns: 200px 1fr;
        }
    }

    @media (max-width: 768px) {
        .institutional-layout {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .stream-options-list {
            grid-template-columns: 1fr;
        }
        .col-quiz-nav {
            border-right: none;
            border-bottom: 1px solid var(--border-color);
            min-height: auto;
            position: static;
            padding-bottom: 20px;
        }
        .quiz-nav-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .quiz-nav-list li {
            border-left: none;
            border-bottom: 3px solid transparent;
            padding: 8px 12px;
        }
        .quiz-nav-list li.active {
            border-left: none;
            border-bottom: 3px solid var(--primary-blue);
        }
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="institutional-container">
    <!-- Breadcrumbs -->
    <% const breadcrumbs=[ { name: 'Home' , url: '/' }, { name: 'Career Quiz' , url: '' } ]; %>
    <%- include('partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>
    <div style="margin-bottom: 20px;"></div>

    <div class="institutional-layout">
        
        <!-- Column 1: Quiz Progress Navigation -->
        <aside class="col-quiz-nav">
            <h3 class="nav-heading">Quiz Progress</h3>
            <ul class="quiz-nav-list" id="quizNavList">
                <li class="active" id="nav-step-stream">Select Stream</li>
                <li id="nav-step-q1">Question 1</li>
                <li id="nav-step-q2">Question 2</li>
                <li id="nav-step-q3">Question 3</li>
                <li id="nav-step-q4">Question 4</li>
                <li id="nav-step-q5">Question 5</li>
                <li id="nav-step-info">Your Details</li>
            </ul>
        </aside>

        <!-- Column 3: Main Quiz Content -->
        <main class="col-quiz-content">
            
            <!-- Stream Selection -->
            <div class="quiz-step active" id="streamStep">
                <div class="quiz-header">
                    <h2>Academic Stream</h2>
                    <p>Select your current or preferred field of study</p>
                </div>

                <div class="stream-options-list">
                    <div class="stream-option-card" data-value="science">
                        <i class="fas fa-flask"></i>
                        <div class="stream-text-content">
                            <div class="stream-option-title">Science</div>
                            <div class="stream-option-subtitle">Physics, Chemistry, Biology</div>
                        </div>
                    </div>
                    <div class="stream-option-card" data-value="commerce">
                        <i class="fas fa-chart-line"></i>
                        <div class="stream-text-content">
                            <div class="stream-option-title">Commerce</div>
                            <div class="stream-option-subtitle">Business, Economics, Accounts</div>
                        </div>
                    </div>
                    <div class="stream-option-card" data-value="arts">
                        <i class="fas fa-palette"></i>
                        <div class="stream-text-content">
                            <div class="stream-option-title">Arts & Humanities</div>
                            <div class="stream-option-subtitle">Design, Law, Literature</div>
                        </div>
                    </div>
                    <div class="stream-option-card" data-value="engineering">
                        <i class="fas fa-cogs"></i>
                        <div class="stream-text-content">
                            <div class="stream-option-title">Engineering</div>
                            <div class="stream-option-subtitle">Technology, Computer Science</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Questions -->
            <div class="quiz-step" id="questionsStep">
                <div class="question-container" id="questionContainer">
                    <!-- Questions dynamically inserted by JS -->
                </div>

                <div class="quiz-navigation">
                    <button class="quiz-btn" onclick="previousQuestion()" id="prevBtn" style="display:none;">
                        <i class="fas fa-arrow-left"></i> Previous
                    </button>
                </div>
            </div>

            <!-- Student Info Collection -->
            <div class="quiz-step" id="studentInfoStep">
                <div class="quiz-header">
                    <h2>Your Details</h2>
                    <p>Please provide your information to receive personalized recommendations</p>
                </div>

                <form id="studentInfoForm" class="student-info-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="studentName">Full Name <span class="required">*</span></label>
                            <input type="text" id="studentName" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="studentPhone">Phone Number <span class="required">*</span></label>
                            <input type="tel" id="studentPhone" class="form-control" required pattern="[0-9]{10}">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="studentEmail">Email Address <span class="required">*</span></label>
                            <input type="email" id="studentEmail" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="studentCity">City</label>
                            <input type="text" id="studentCity" class="form-control">
                        </div>
                    </div>

                    <button type="submit" class="quiz-btn accent">
                        Get Recommendations
                    </button>
                </form>
            </div>

            <!-- Loading State -->
            <div class="quiz-step" id="loadingStep">
                <div class="loading-container">
                    <div class="loader"></div>
                    <h2 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--academic-dark);">Analyzing Your Responses...</h2>
                    <p style="color: var(--text-gray); margin-top: 10px;">Matching you with the perfect universities based on your profile.</p>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
    let currentQuestion = 0;
    let quizAnswers = {};
    let selectedStream = '';
    let totalQuestions = 5;

    // Initialize stream selection
    document.querySelectorAll('.stream-option-card').forEach(card => {
        card.addEventListener('click', function () {
            document.querySelectorAll('.stream-option-card').forEach(c => c.classList.remove('selected'));
            this.classList.add('selected');
            selectedStream = this.dataset.value;

            // Auto-advance to questions after showing selection
            setTimeout(() => {
                document.getElementById('streamStep').classList.remove('active');
                document.getElementById('questionsStep').classList.add('active');
                loadQuestion(0);
                updateProgress();
            }, 300);
        });
    });

    // AUTO-ADVANCE: Click option → mark selected → redirect to next
    function setupQuestionOptions() {
        document.querySelectorAll('.question-option').forEach(option => {
            option.addEventListener('click', function () {
                if (this.classList.contains('selected')) return;

                this.parentElement.querySelectorAll('.question-option').forEach(opt => {
                    opt.classList.remove('selected');
                });

                this.classList.add('selected');

                const questionId = this.closest('.question-card').dataset.questionId;
                quizAnswers[questionId] = this.dataset.value;

                this.parentElement.querySelectorAll('.question-option').forEach(opt => {
                    opt.style.pointerEvents = 'none';
                });

                setTimeout(() => {
                    nextQuestion();
                }, 200);
            });
        });
    }

    function nextQuestion() {
        currentQuestion++;

        if (currentQuestion >= totalQuestions) {
            document.getElementById('questionsStep').classList.remove('active');
            document.getElementById('studentInfoStep').classList.add('active');
        } else {
            loadQuestion(currentQuestion);
        }

        updateProgress();

        if (currentQuestion > 0) {
            document.getElementById('prevBtn').style.display = 'inline-flex';
        }
    }

    function previousQuestion() {
        if (currentQuestion > 0) {
            currentQuestion--;
            loadQuestion(currentQuestion);
            updateProgress();

            if (currentQuestion === 0) {
                document.getElementById('prevBtn').style.display = 'none';
            }
        }
    }

    function loadQuestion(index) {
        const questions = [
            {
                id: 'q1',
                text: 'What is your primary career goal?',
                options: [
                    { value: 'research', text: 'Research and Development' },
                    { value: 'corporate', text: 'Corporate Career' },
                    { value: 'entrepreneurship', text: 'Entrepreneurship' },
                    { value: 'academia', text: 'Academic Career' }
                ]
            },
            {
                id: 'q2',
                text: 'What is your preferred study location?',
                options: [
                    { value: 'domestic', text: 'Within My Country' },
                    { value: 'international', text: 'Study Abroad' },
                    { value: 'online', text: 'Online/Remote' },
                    { value: 'hybrid', text: 'Hybrid (Mix of Both)' }
                ]
            },
            {
                id: 'q3',
                text: 'What is your budget range for education?',
                options: [
                    { value: 'budget', text: 'Budget Friendly (Under 5 Lakhs)' },
                    { value: 'moderate', text: 'Moderate (5-10 Lakhs)' },
                    { value: 'premium', text: 'Premium (10-20 Lakhs)' },
                    { value: 'luxury', text: 'Luxury (Above 20 Lakhs)' }
                ]
            },
            {
                id: 'q4',
                text: 'What type of campus environment do you prefer?',
                options: [
                    { value: 'urban', text: 'Urban City Campus' },
                    { value: 'suburban', text: 'Suburban Area' },
                    { value: 'rural', text: 'Rural/Countryside' },
                    { value: 'any', text: 'No Preference' }
                ]
            },
            {
                id: 'q5',
                text: 'What matters most to you in a university?',
                options: [
                    { value: 'ranking', text: 'University Ranking & Reputation' },
                    { value: 'placement', text: 'Placement Opportunities' },
                    { value: 'research', text: 'Research Facilities' },
                    { value: 'culture', text: 'Campus Culture & Activities' }
                ]
            }
        ];

        const question = questions[index];
        const questionHTML = `
    <div class="question-card" data-question-id="${question.id}">
        <div class="question-number">Question ${index + 1} of ${totalQuestions}</div>
        <h3 class="question-text">${question.text}</h3>
        
        <div class="answer-options">
            ${question.options.map((opt, i) => `
                <div class="question-option" data-value="${opt.value}">
                    <div class="option-number">${String.fromCharCode(65 + i)}</div>
                    <div class="option-text">${opt.text}</div>
                </div>
            `).join('')}
        </div>
    </div>
`;

        document.getElementById('questionContainer').innerHTML = questionHTML;
        setupQuestionOptions();
    }

    // UPDATE PROGRESS LOGIC FOR VERTICAL NAV
    function updateProgress() {
        const navItems = document.querySelectorAll('.quiz-nav-list li');
        navItems.forEach(li => {
            li.classList.remove('active');
            li.classList.remove('completed');
        });

        const isStream = document.getElementById('streamStep').classList.contains('active');
        const isInfo = document.getElementById('studentInfoStep').classList.contains('active');
        const isLoading = document.getElementById('loadingStep').classList.contains('active');

        if (isStream) {
            document.getElementById('nav-step-stream').classList.add('active');
        } else if (isInfo || isLoading) {
            // Mark everything up to details as completed
            document.getElementById('nav-step-stream').classList.add('completed');
            for(let i=1; i<=5; i++) {
                document.getElementById('nav-step-q'+i).classList.add('completed');
            }
            document.getElementById('nav-step-info').classList.add('active');
        } else {
            // Questions
            document.getElementById('nav-step-stream').classList.add('completed');
            for(let i=1; i<=currentQuestion; i++) {
                document.getElementById('nav-step-q'+i).classList.add('completed');
            }
            document.getElementById('nav-step-q' + (currentQuestion + 1)).classList.add('active');
        }
    }

    // Form submission
    document.getElementById('studentInfoForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        document.getElementById('studentInfoStep').classList.remove('active');
        document.getElementById('loadingStep').classList.add('active');
        updateProgress();

        const formData = {
            name: document.getElementById('studentName').value,
            phone: document.getElementById('studentPhone').value,
            email: document.getElementById('studentEmail').value,
            city: document.getElementById('studentCity').value,
            stream: selectedStream,
            answers: quizAnswers
        };

        try {
            const response = await fetch('/api/leads/quiz', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success) {
                // Calculate quiz score based on answers
                const quizScore = calculateScore(quizAnswers);

                // Store results with recommendations from API
                const quizResults = {
                    quizScore: quizScore,
                    recommendations: result.recommendations || []
                };

                // Add match percentages to recommendations
                quizResults.recommendations = quizResults.recommendations.map((uni, index) => {
                    return {
                        ...uni,
                        matchPercentage: 95 - (index * 3), // Descending match %
                        id: uni._id,
                        image: uni.logo || uni.image || '/images/default-university.jpg'
                    };
                });

                localStorage.setItem('quizResults', JSON.stringify(quizResults));

                setTimeout(() => {
                    window.location.href = '/quiz-results';
                }, 2000);
            } else {
                alert('Error submitting quiz. Please try again.');
                document.getElementById('loadingStep').classList.remove('active');
                document.getElementById('studentInfoStep').classList.add('active');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Network error. Please try again.');
            document.getElementById('loadingStep').classList.remove('active');
            document.getElementById('studentInfoStep').classList.add('active');
        }
    });

    // Calculate score based on answers
    function calculateScore(answers) {
        let score = 60; // Base score

        // Add points based on specific answers
        if (answers.q1 === 'corporate') score += 10;
        if (answers.q2 === 'domestic') score += 8;
        if (answers.q3 === 'moderate') score += 7;
        if (answers.q4 !== 'any') score += 5;
        if (answers.q5 === 'placement') score += 10;

        return Math.min(score, 100); // Cap at 100
    }
</script>

